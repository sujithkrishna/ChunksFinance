
-- Create ACCOUNT table
create table account (
    account_holder_name integer, 
    account_id integer not null, 
    balance_amount numeric(19,2), 
    balance_amount_including_interest numeric(19,2), 
    finance_id integer, 
    current_status enum ('ACTIVE','CLOSED') not null, 
    primary key (account_id), 
    unique (account_holder_name, finance_id)
);

-- Create ACCOUNT_TRANSACTIONS table
create table account_transactions (
    account_holder_name integer, 
    account_transactions_id integer not null, 
    actual_payment_date date, 
    finance_id integer, 
    first_approver_member_no integer, 
    paid_amount numeric(19,2), 
    second_approver_member_no integer, 
    total_amount numeric(19,2), 
    first_approval_date_time timestamp(6), 
    paid_date timestamp(6), 
    second_approval_date_time timestamp(6), 
    primary key (account_transactions_id)
);

-- Create CHITS table
create table chits (
    chits_name_of integer, 
    chits_no integer not null, 
    chits_start_date date, 
    finance_id integer, 
    first_approver_member_no integer, 
    second_approver_member_no integer, 
    total_chits_amount integer, 
    total_chits_number integer, 
    first_approval_date_time timestamp(6), 
    second_approval_date_time timestamp(6), 
    current_status enum ('CLOSED','INITIAL_APPROVAL','INPROGRESS','REJECTED','REQUESTED') not null, 
    primary key (chits_no)
);

-- Create CHITS_EMI_DETAIL table
create table chits_emi_detail (
    amount numeric(19,2), 
    chits_no integer, 
    emi_date date, 
    emi_id integer not null, 
    emi_number integer, 
    first_approver_member_no integer, 
    paid_on_time boolean, 
    second_approver_member_no integer, 
    first_approval_date_time timestamp(6), 
    payment_date_time timestamp(6), 
    second_approval_date_time timestamp(6), 
    current_status enum ('INITIAL_APPROVAL','INPROGRESS','PAID','REQUESTED') not null, 
    primary key (emi_id)
);

-- Create EXPENSES table
create table expenses (
    expenses_number integer not null, 
    finance_id integer, 
    first_approver_member_no integer, 
    second_approver_member_no integer, 
    spend_amount float(53) not null, 
    spend_date date not null, 
    spender_member_no integer, 
    first_approval_date_time timestamp(6), 
    second_approval_date_time timestamp(6), 
    spender_details varchar(255), 
    current_status enum ('COMPLETED','INITIAL_APPROVAL','INPROGRESS','REJECTED') not null, 
    primary key (expenses_number)
);

-- Create FINANCE table
create table finance (
    current_balance float(53), 
    finance_amount float(53), 
    finance_creationdate date not null, 
    finance_owner_no integer, 
    id integer not null, 
    interest_amount float(53), 
    loan_priority_order_number integer, 
    finance_name varchar(255) not null, 
    finance_type enum ('PRIMARY','SECONDARY') not null, 
    status enum ('ACTIVE','CLOSED') not null, 
    primary key (id), 
    constraint uniq_finance_composite unique (finance_type, finance_name, finance_owner_no)
);

-- Create FINANCE_TRANSFER table
create table finance_transfer (
    destination_finance_type integer, 
    finance_amount float(53), 
    finance_transfer_date date not null, 
    first_approver_member_no integer, 
    id integer not null, 
    second_approver_member_no integer, 
    source_finance_type integer, 
    first_approval_date_time timestamp(6), 
    second_approval_date_time timestamp(6), 
    current_status enum ('CLOSED','INITIAL_APPROVAL','PENDING','REJECTED','REQUESTED') not null, 
    primary key (id)
);

-- Create LOAN table
create table loan (
    disbursement_amount numeric(19,2), 
    finance_id integer, 
    first_approver_member_no integer, 
    interest_amount numeric(19,2), 
    loan_amount numeric(19,2), 
    loan_applicant_name integer, 
    loan_date date, 
    loan_end_date date, 
    loan_no integer not null, 
    loan_preclosure_date date, 
    loan_preclosure_request_date date, 
    loan_reference_name integer, 
    loan_start_date date, 
    preclosure_amount numeric(19,2), 
    received_amount numeric(19,2), 
    remaining_balance numeric(19,2), 
    second_approver_member_no integer, 
    first_approval_date_time timestamp(6), 
    second_approval_date_time timestamp(6), 
    current_status enum ('CLOSED','INITIAL_APPROVAL','INPROGRESS','PRECLOSURE_CLOSED','PRECLOSURE_INITIAL_APPROVAL','PRECLOSURE_REQUEST','REJECTED','REQUESTED') not null, 
    primary key (loan_no)
);

-- Create LOAN_EMI_DETAIL table
create table loan_emi_detail (
    emi_amount numeric(19,2), 
    emi_date date, 
    emi_id integer not null, 
    emi_number integer, 
    first_approver_member_no integer, 
    loan_no integer, 
    paid_amount numeric(19,2), 
    paid_on_time boolean, 
    second_approver_member_no integer, 
    first_approval_date_time timestamp(6), 
    payment_date_time timestamp(6), 
    second_approval_date_time timestamp(6), 
    current_status enum ('INITIAL_APPROVAL','INPROGRESS','PAID','PAYMENT_INITIAL_APPROVAL','PAYMENT_INITIATED','PAYMENT_SECOND_APPROVAL','PAYMENT_SUBMITTED','PRECLOSE','REQUESTED') not null, 
    primary key (emi_id)
);

-- Create LOAN_ENQUIRES table
create table loan_enquires (
    loan_amount numeric(19,2), 
    loan_enquires_date date, 
    loan_enquires_id integer not null, 
    loan_enquires_reference_name integer, 
    enquires_applicant_name varchar(255), 
    current_status enum ('CLOSE','OPEN') not null, 
    primary key (loan_enquires_id)
);

-- Create MEMBERS table
create table members (
    member_dob date, 
    no integer not null, 
    reference_member_no integer, 
    address1 varchar(255), 
    district varchar(255), 
    email_id varchar(255) not null unique, 
    member_name varchar(255) not null, 
    mobile_number varchar(255), 
    password varchar(255) not null, 
    pincode varchar(255), 
    place varchar(255), 
    state varchar(255), 
    taluk varchar(255), 
    member_type enum ('PRIMARY','SECONDARY') not null, 
    role enum ('SUPER_ADMIN','USER') not null, 
    primary key (no), 
    constraint uniq_member_composite unique (member_name, member_type, reference_member_no)
);

-- Create REVENUE table
create table revenue (
    finance_id integer, 
    first_approver_member_no integer, 
    revenue_number integer not null, 
    second_approver_member_no integer, 
    spend_amount float(53) not null, 
    spend_date date not null, 
    spender_member_no integer, 
    first_approval_date_time timestamp(6), 
    second_approval_date_time timestamp(6), 
    spender_details varchar(255), 
    current_status enum ('COMPLETED','INITIAL_APPROVAL','INPROGRESS','REJECTED') not null, 
    primary key (revenue_number)
);

-- Create SETTINGS table
create table settings (
    last_updated_member_no integer, 
    no integer not null, 
    last_updated_date timestamp(6), 
    settings_name varchar(255), 
    settings_value varchar(255), 
    primary key (no)
);




